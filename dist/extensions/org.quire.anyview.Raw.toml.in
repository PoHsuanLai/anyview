# The manifest of the RAW plugin (ARCHITECTURE section 2l). install.sh fills in
# @PREFIX@ and installs the result as <prefix>/share/quire/extensions/org.quire.anyview.Raw/extension.toml (an Extension: the folder name is the id).
#
# The plugin runs the person's own LibRaw `dcraw_emu` (or `dcraw`) and links no LibRaw: it looks for
# them as `--dcraw-emu` and `--dcraw` arguments (add them to `args` to name an absolute path), then
# the ANYVIEW_DCRAW_EMU and ANYVIEW_DCRAW environment variables, then the search path. It tells the
# host in `hello` what this machine has. The viewer shows a raw file's embedded preview by itself;
# this plugin adds the full development, and the embedded preview as a thumbnail.
id = "org.quire.anyview.Raw"
name = "RAW"
protocol = 1
# The numbers of the workspace version (bayonet compares dotted numbers); the dist test keeps them equal.
version = "0.1.0"
licence = "MIT OR Apache-2.0"
summary = "Camera raw pictures developed in full, through your own LibRaw tools"

[program]
path = "@PREFIX@/libexec/anyview/anyview-raw"
args = []

[[provides]]
capability = "thumbnail"
mimes = ["image/x-dcraw"]

[[provides]]
capability = "decode"
mimes = ["image/x-dcraw"]
